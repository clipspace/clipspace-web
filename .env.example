# Supabase Postgres connection string.
# Use the pooled connection string from Supabase → Project Settings → Database.
DATABASE_URL=

# Password for the /admin panel.
# If this is empty or missing, the admin panel is disabled entirely and every
# admin action refuses to run. The public GET /api/official-servers endpoint
# keeps working.
ADMIN_PASSWORD=

# Resend API key for the feedback form (https://resend.com/api-keys).
# The sender domain djt-group.com must be verified in the same Resend account.
# Without it the form still renders, but submissions get a 503 and the
# visitor is told to email instead.
RESEND_API_KEY=
# Sender and recipient overrides; both default to clipspace@djt-group.com.
FEEDBACK_FROM=
FEEDBACK_TO=
